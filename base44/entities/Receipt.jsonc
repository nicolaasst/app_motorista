{
  "name": "Receipt",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "fortnight": {
      "type": "number",
      "enum": [
        1,
        2
      ]
    },
    "gross": {
      "type": "number"
    },
    "discounts_total": {
      "type": "number"
    },
    "net": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "previsto",
        "pendente_assinatura",
        "em_contestacao",
        "assinado",
        "pago"
      ]
    },
    "sign_deadline": {
      "type": "string",
      "format": "date"
    },
    "deposit_date": {
      "type": "string",
      "format": "date"
    },
    "paid_at": {
      "type": "string",
      "format": "date"
    },
    "paid_via": {
      "type": "string"
    },
    "bank_snapshot": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_png": {
      "type": "string"
    },
    "signature_hash": {
      "type": "string"
    },
    "sign_lat": {
      "type": "number"
    },
    "sign_lng": {
      "type": "number"
    },
    "sign_ip": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "driver_id",
    "net"
  ]
}