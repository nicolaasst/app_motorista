{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string"
    },
    "bank_code": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "agency": {
      "type": "string"
    },
    "account": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "corrente",
        "poupanca"
      ]
    },
    "pix_key_type": {
      "type": "string",
      "enum": [
        "cpf",
        "cnpj",
        "celular",
        "email",
        "aleatoria"
      ]
    },
    "pix_key": {
      "type": "string"
    },
    "is_primary": {
      "type": "boolean"
    },
    "changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "pending_change": {
      "type": "boolean"
    }
  },
  "required": [
    "driver_id",
    "bank_code",
    "agency",
    "account"
  ]
}