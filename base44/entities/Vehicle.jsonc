{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "plate": {
      "type": "string"
    },
    "brand_model": {
      "type": "string"
    },
    "body_type": {
      "type": "string"
    },
    "fleet": {
      "type": "string"
    },
    "last_odometer_km": {
      "type": "number"
    },
    "crlv_year": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "operacional",
        "manutencao",
        "indisponivel"
      ]
    }
  },
  "required": [
    "plate",
    "brand_model"
  ]
}