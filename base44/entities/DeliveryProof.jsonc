{
  "name": "DeliveryProof",
  "type": "object",
  "properties": {
    "stop_id": {
      "type": "string"
    },
    "receiver_name": {
      "type": "string"
    },
    "receiver_doc": {
      "type": "string"
    },
    "receiver_is_holder": {
      "type": "boolean"
    },
    "receiver_type": {
      "type": "string",
      "enum": [
        "proprio_destinatario",
        "conjuge_familiar",
        "porteiro_portaria",
        "recepcao_zelador",
        "vizinho",
        "funcionario_local",
        "outro"
      ]
    },
    "receiver_type_other": {
      "type": "string"
    },
    "signature_png": {
      "type": "string"
    },
    "signature_hash": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "taken_at": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "hash": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "accuracy_m": {
      "type": "number"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "device_info": {
      "type": "string"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "pendente",
        "enviando",
        "ok",
        "erro"
      ]
    }
  },
  "required": [
    "stop_id",
    "receiver_name"
  ]
}