{
  "name": "Stop",
  "type": "object",
  "properties": {
    "route_id": {
      "type": "string"
    },
    "sequence": {
      "type": "number"
    },
    "kind": {
      "type": "string",
      "enum": [
        "comercial",
        "residencial",
        "hospital",
        "clinica",
        "mercado",
        "outro"
      ]
    },
    "recipient_name": {
      "type": "string"
    },
    "doc_cnpj": {
      "type": "string"
    },
    "address_line": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "cep": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "window_start": {
      "type": "string"
    },
    "window_end": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_role": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "access_instructions": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "nao_iniciada",
        "em_rota",
        "em_atendimento",
        "entregue",
        "falha",
        "reagendada"
      ]
    },
    "arrived_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "eta": {
      "type": "string"
    }
  },
  "required": [
    "route_id",
    "sequence",
    "recipient_name",
    "address_line"
  ]
}