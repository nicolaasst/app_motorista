{
  "name": "SyncQueueItem",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "delivery",
        "failure",
        "checklist",
        "scan",
        "photo",
        "hazard",
        "message"
      ]
    },
    "payload": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "enviando",
        "erro",
        "ok"
      ]
    },
    "attempts": {
      "type": "number"
    },
    "last_error": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "driver_id",
    "kind"
  ]
}