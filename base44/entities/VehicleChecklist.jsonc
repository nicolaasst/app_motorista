{
  "name": "VehicleChecklist",
  "type": "object",
  "properties": {
    "route_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "pre",
        "retorno"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "ok": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "photo": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "odometer_km": {
      "type": "number"
    },
    "odometer_photo": {
      "type": "string"
    },
    "declaration_accepted": {
      "type": "boolean"
    },
    "supervisor_name": {
      "type": "string"
    },
    "supervisor_matricula": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signed_hash": {
      "type": "string"
    }
  },
  "required": [
    "route_id",
    "type"
  ]
}