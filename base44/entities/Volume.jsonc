{
  "name": "Volume",
  "type": "object",
  "properties": {
    "stop_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "nf_number": {
      "type": "string"
    },
    "nfe_key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "ean": {
      "type": "string"
    },
    "vol_code": {
      "type": "string"
    },
    "weight_kg": {
      "type": "number"
    },
    "kind": {
      "type": "string",
      "enum": [
        "sensivel",
        "seco",
        "documento"
      ]
    },
    "scan_status": {
      "type": "string",
      "enum": [
        "pendente",
        "bipado",
        "divergente"
      ]
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "scanned_by": {
      "type": "string"
    },
    "return_status": {
      "type": "string",
      "enum": [
        "none",
        "devolver",
        "devolvido"
      ]
    },
    "returned_at": {
      "type": "string",
      "format": "date-time"
    },
    "return_dock": {
      "type": "string"
    }
  },
  "required": [
    "stop_id",
    "vol_code"
  ]
}