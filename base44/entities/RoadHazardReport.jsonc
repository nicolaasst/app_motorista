{
  "name": "RoadHazardReport",
  "type": "object",
  "properties": {
    "route_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "transito",
        "acidente",
        "via_bloqueada",
        "blitz",
        "obra",
        "alagamento",
        "risco"
      ]
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "photo": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "driver_id",
    "type"
  ]
}