{
  "name": "Notification",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "rota",
        "recibo",
        "chamado",
        "alerta",
        "sistema"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "deep_link": {
      "type": "string"
    },
    "read": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "driver_id",
    "type",
    "title"
  ]
}