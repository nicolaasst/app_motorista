# App Motorista (NGS Driver) — variáveis públicas do frontend (vão para o navegador).
# Nenhum segredo aqui: o que protege os dados é a RLS do banco.

# Supabase: MESMO projeto do TMS (rcweqbvdkskjtzjgpsnl) — não é um projeto novo.
# Mesmos valores que o TMS usa na Vercel.
VITE_SUPABASE_URL=https://rcweqbvdkskjtzjgpsnl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mapbox: mapas e rotas (mesmo provedor do TMS). Token público `pk.*`,
# restrito por URL no painel do Mapbox. Sem ele: tiles de contingência e,
# em produção, sem traçado de rota por vias (ver src/lib/mapProvider.js).
VITE_MAPBOX_PUBLIC_TOKEN=

# Segredos das Edge Functions (NÃO vão aqui; ficam em Supabase > Edge Functions > Secrets):
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_DOCUMENTOS
#   (SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são injetadas pelo Supabase)
